# Public URL of the deployed site. Used for share text and the QR code on
# generated cards. If unset, the browser's current origin is used.
NEXT_PUBLIC_SITE_URL=

# Public GitHub repository URL shown in the footer and Community section.
NEXT_PUBLIC_REPO_URL=https://github.com/open-life-alliance/open-life-alliance

# Public contact address for the project (not a personal address).
NEXT_PUBLIC_CONTACT_EMAIL=
